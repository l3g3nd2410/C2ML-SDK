<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>C2ML.ExampleMod</AssemblyName>
    <RootNamespace>C2ML.ExampleMod</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.png" LogicalName="C2ML.ExampleMod.icon.png" />
  </ItemGroup>

  <!--
    Ces trois DLL viennent du dossier C2ML de ton installation du jeu (ou du dossier lib\ du SDK, copie depuis le
    meme endroit) :
      - C2ML.API.dll               : l'API publique documentee dans docs\ (toujours la meme pour tous les mods)
      - 0Harmony.dll                : HarmonyX, pour patcher des methodes du jeu (voir docs\07-harmony-patching.md)
      - UnityEngine*.dll             : types Unity de base (Time, Application...), presents sur toute installation
    Adapte les chemins ci-dessous a TON installation si elle n'est pas au meme endroit.
  -->
  <ItemGroup>
    <Reference Include="C2ML.API">
      <HintPath>..\..\lib\C2ML.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>D:\SteamLibrary\steamapps\common\CarX Drift Racing Online 2\C2ML\cache\unity-libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>D:\SteamLibrary\steamapps\common\CarX Drift Racing Online 2\C2ML\cache\unity-libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
